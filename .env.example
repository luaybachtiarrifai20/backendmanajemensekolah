# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=manajemen_sekolah
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=secret_key_yang_aman_dan_unik

# Firebase Cloud Messaging (FCM) - Service Account Method
FCM_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FCM_ENABLED=true

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
